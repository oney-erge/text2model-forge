# Machine-local config: real binary paths and env vars, never portable.
.setup/
config.local.toml
config.local.json
# The container sample has no machine paths or credentials and is intentionally
# versioned; only the repository-root machine config stays ignored.
!docker/config.local.toml

# Python
__pycache__/
*.py[cod]
*$py.class
.venv*/
venv/
.tox/
.nox/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.ipynb_checkpoints/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/
build/
dist/
wheelhouse/

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
.AppleDouble

# Local secrets and process output
.env
.env.*
!.env.example
*.log
*.pid
*.tmp
*.bak
*.dmp
*.sqlite
*.sqlite3
/artifacts/
/logs/
/outputs/
/runs/
/tmp/
/temp/

# Vendored/generated ComfyUI-style runtime and downloaded model weights, if
# a worker environment is ever set up alongside the repo instead of outside it.
runtime/
workspaces/
*.safetensors
*.ckpt
*.pt
*.pth
*.gguf
*.onnx
*.blend[0-9]*

# Unity creates these large machine-specific folders if the optional smoke
# template is opened directly in the editor.
/resources/unity_smoke_template/Library/
/resources/unity_smoke_template/Temp/
/resources/unity_smoke_template/Obj/
/resources/unity_smoke_template/Logs/
/resources/unity_smoke_template/UserSettings/

# Local run output, never checked in.
/Text2ModelForgeRuns/

# Machine-local recovery notes produced while repairing a ComfyUI install.
/.comfyui-revert-to.txt
/.comfyui-torch-before.txt
/resources/motion_library/catalog.json
